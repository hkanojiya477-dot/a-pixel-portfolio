# 1. Copy this file and rename the copy to ".env.local"
# 2. Paste your values from Supabase → Project Settings → API (or "API Keys")
#
# These two values are SAFE to use in the browser. Your data is protected by
# the Row Level Security rules in supabase/schema.sql, not by hiding these keys.
#
# NEVER put the "service_role" / "secret" key in this project. It is not needed.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-or-publishable-key-here

# Your website address (use http://localhost:3000 while testing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
